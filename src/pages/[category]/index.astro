---
import { CATEGORIES, byCategory } from '../../data/calculators.js';
import Footer from '../../components/Footer.astro';
import Head from '../../components/Head.astro';

export function getStaticPaths() {
  return Object.entries(CATEGORIES).map(([key, c]) => ({
    params: { category: key },
    props: { key, category: c },
  }));
}

const { key, category } = Astro.props;
const calculators = byCategory(key);
const others = Object.entries(CATEGORIES).filter(([k]) => k !== key);
---

<html lang="en">
<head>
  <Head
    title={`${category.label} Calculators`}
    description={category.blurb}
    canonical={Astro.url.pathname}
  />
</head>
<body>
  <nav><a href="/calculators/">All calculators</a> › {category.label}</nav>

  <h1>{category.label} Calculators</h1>
  <p>{category.blurb}</p>

  <ul>
    {calculators.map((c) => (
      <li>
        <a href={c.href}>{c.name}</a> — {c.blurb}
      </li>
    ))}
  </ul>

  <h2>Other categories</h2>
  <ul>
    {others.map(([k, c]) => (
      <li><a href={`/${k}/`}>{c.label}</a></li>
    ))}
  </ul>
  <Footer />
</body>
</html>
