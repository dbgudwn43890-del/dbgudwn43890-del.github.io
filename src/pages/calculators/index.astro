---
import { CATEGORIES, byCategory } from '../../data/calculators.js';
import Footer from '../../components/Footer.astro';
import Head from '../../components/Head.astro';
---

<html lang="en">
<head>
  <Head
    title="All Material Calculators · Mattally"
    description="Browse every Mattally calculator for landscaping, concrete, flooring and painting projects."
    canonical="/calculators/"
  />
</head>
<body>
  <nav><a href="/">Mattally</a> › All calculators</nav>
  <h1>All Material Calculators</h1>
  <p>Pick the material you are buying. Each calculator gives you the quantity to order in the units suppliers actually sell.</p>

  {Object.entries(CATEGORIES).map(([key, c]) => (
    <>
      <h2><a href={`/${key}/`}>{c.label}</a></h2>
      <ul>
        {byCategory(key).map((calc) => (
          <li><a href={calc.href}>{calc.name}</a> — {calc.blurb}</li>
        ))}
      </ul>
    </>
  ))}
  <Footer />
</body>
</html>
